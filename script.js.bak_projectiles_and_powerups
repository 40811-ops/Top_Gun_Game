const sound = new SoundManager();

// --- 5. CENÁRIO PARALAXE COM SUPORTE AOS CENÁRIOS REAIS ---
class ParallaxBackground {
        constructor(width, height) {
          this.width = width;
          this.height = height;
          this.stageId = 'ocean';

          this.scrollOffset = 0;
          this.textureOffset = 0;
          this.scrollSpeed = 1.0;
          this.clouds = [];
          this.foregroundClouds = [];

          this.prevStageId = null;
          this.isTransitioning = false;
          this.transitionProgress = 1.0;
          this.transitionDuration = 3.0;

          this.surfaceTargets = []; // Campanha aérea pura: zero alvos navais ou terrestres

          this.initClouds();
          this.initForegroundClouds();
        }

        setStage(stageId, smooth = false, duration = 3.0) {
          if (smooth) {
            this.transitionToStage(stageId, duration);
            return;
          }
          this.stageId = stageId;
          this.isTransitioning = false;
          this.transitionProgress = 1.0;
          this.prevStageId = null;
        }

        transitionToStage(newStageId, duration = 3.0) {
          if (this.stageId === newStageId && !this.isTransitioning) return;
          this.prevStageId = this.stageId;
          this.stageId = newStageId;
          this.isTransitioning = true;
          this.transitionProgress = 0;
          this.transitionDuration = duration;
        }

        initClouds() {
          this.clouds = [];
          for (let i = 0; i < 7; i++) {
            this.clouds.push({
              x: Math.random() * this.width,
              y: Math.random() * this.height,
              scale: Math.random() * 0.7 + 0.6,
              alpha: Math.random() * 0.22 + 0.12,
              speed: Math.random() * 0.5 + 1.2
            });
          }
        }

        initForegroundClouds() {
          this.foregroundClouds = [];
          for (let i = 0; i < 4; i++) {
            this.foregroundClouds.push({
              x: Math.random() * this.width,
              y: Math.random() * this.height,
              scale: Math.random() * 0.8 + 1.0,
              alpha: Math.random() * 0.06 + 0.04,
              speed: Math.random() * 0.6 + 2.2
            });
          }
        }

        update(dt, enemyBullets, playerX, playerY, bulletSpeedMult) {
          this.scrollOffset = (this.scrollOffset + this.scrollSpeed * dt * 60) % 60;
          const speedFactor = this.stageId === 'estratosfera' ? 180 : 42;
          this.textureOffset += this.scrollSpeed * dt * speedFactor;

          this.surfaceTargets.length = 0; // Garantia absoluta: sem navios, canhões ou alvos terrestres

          if (this.isTransitioning) {
            this.transitionProgress += dt / this.transitionDuration;
            if (this.transitionProgress >= 1) {
              this.isTransitioning = false;
              this.transitionProgress = 1.0;
              this.prevStageId = null;
            }
          }

          if (this.stageId !== 'estratosfera') {
            for (let c of this.clouds) {
              c.y += c.speed * dt * 60;
              if (c.y > this.height + 80) {
                c.y = -80;
                c.x = Math.random() * this.width;
              }
            }
            for (let fc of this.foregroundClouds) {
              fc.y += fc.speed * dt * 60;
              if (fc.y > this.height + 120) {
                fc.y = -120;
                fc.x = Math.random() * this.width;
              }
            }
          }
        }

        drawBiomeBackground(ctx, stageId, alpha = 1.0) {
          if (alpha <= 0.001) return;
          ctx.save();
          ctx.globalAlpha = Math.max(0, Math.min(1, alpha));

          let bgImg = scenarioSprites[stageId];
          if (!bgImg && stageId === 'coast') bgImg = scenarioSprites.deserto;
          if (!bgImg && stageId === 'jungle') bgImg = scenarioSprites.montanhas;
          if (!bgImg) bgImg = scenarioSprites.ocean;

          if (bgImg && bgImg.complete && bgImg.naturalWidth > 0) {
            const tileW = this.width;
            const tileH = bgImg.height * (tileW / bgImg.width);
            const offset = ((this.textureOffset % tileH) + tileH) % tileH;

            ctx.fillStyle = '#06172b';
            ctx.fillRect(0, 0, this.width, this.height);

            ctx.drawImage(bgImg, 0, offset - tileH, tileW, tileH + 1);
            ctx.drawImage(bgImg, 0, offset, tileW, tileH + 1);
            if (offset + tileH < this.height) {
              ctx.drawImage(bgImg, 0, offset + tileH, tileW, tileH + 1);
            }

            ctx.fillStyle = 'rgba(2, 10, 24, 0.12)';
            ctx.fillRect(0, 0, this.width, this.height);
            ctx.restore();
            return;
          }

          const grad = ctx.createLinearGradient(0, 0, 0, this.height);
          if (stageId === 'deserto' || stageId === 'coast') {
            grad.addColorStop(0, '#3e2723'); grad.addColorStop(1, '#1b0000');
          } else if (stageId === 'montanhas' || stageId === 'jungle') {
            grad.addColorStop(0, '#1b3b22'); grad.addColorStop(1, '#071f30');
          } else if (stageId === 'canyon') {
            grad.addColorStop(0, '#4a2c11'); grad.addColorStop(1, '#2d1808');
          } else if (stageId === 'estratosfera') {
            grad.addColorStop(0, '#020512'); grad.addColorStop(1, '#051838');
          } else {
            grad.addColorStop(0, '#091c33'); grad.addColorStop(1, '#051021');
          }
          ctx.fillStyle = grad;
          ctx.fillRect(0, 0, this.width, this.height);
          ctx.restore();
        }

        draw(ctx) {
          if (this.isTransitioning && this.prevStageId) {
            this.drawBiomeBackground(ctx, this.prevStageId, 1.0 - this.transitionProgress);
            this.drawBiomeBackground(ctx, this.stageId, this.transitionProgress);
          } else {
            this.drawBiomeBackground(ctx, this.stageId, 1.0);
          }

          if (this.stageId !== 'estratosfera') {
            ctx.save();
            for (let c of this.clouds) {
              ctx.save();
              ctx.translate(c.x, c.y);
              ctx.scale(c.scale, c.scale);
              ctx.fillStyle = `rgba(224, 250, 234, ${c.alpha})`;
              ctx.beginPath();
              ctx.arc(0, 0, 38, 0, Math.PI * 2);
              ctx.arc(28, -8, 28, 0, Math.PI * 2);
              ctx.arc(-26, 6, 26, 0, Math.PI * 2);
              ctx.arc(14, 14, 24, 0, Math.PI * 2);
              ctx.fill();
              ctx.restore();
            }
            ctx.restore();
          }
        }

        drawForegroundClouds(ctx) {
          if (this.stageId === 'estratosfera') return;
          ctx.save();
          for (let fc of this.foregroundClouds) {
            ctx.save();
            ctx.translate(fc.x, fc.y);
            ctx.scale(fc.scale, fc.scale);
            ctx.fillStyle = `rgba(255, 255, 255, ${fc.alpha})`;
            ctx.beginPath();
            ctx.arc(0, 0, 60, 0, Math.PI * 2);
            ctx.arc(42, -12, 45, 0, Math.PI * 2);
            ctx.arc(-42, 12, 45, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
          }
          ctx.restore();
        }
      }

      // --- 6. SISTEMA CLIMÁTICO E EVENTOS AMBIENTAIS (WeatherSystem) ---
      class WeatherSystem {
