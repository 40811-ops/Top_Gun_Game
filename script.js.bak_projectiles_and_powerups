            setMode(mode) {
              this.gameMode = mode;
              this.saveData.mode = mode;
              StorageManager.save(this.saveData);
            }

            openSettings() {
              this.settingsModal?.classList.remove('hidden');
            }

            closeSettings() {
              this.settingsModal?.classList.add('hidden');
            }

            openHangar() {
              this.startScreen?.classList.add('hidden');
              this.missionSelectScreen?.classList.add('hidden');
              this.settingsModal?.classList.add('hidden');
              this.hangarScreen?.classList.remove('hidden');

              const hangarGold = document.getElementById('hangarGoldDisplay');
              if (hangarGold) hangarGold.innerText = this.totalGold.toLocaleString();

              this.updateDifficultyUI();
              this.updatePlaneSelectionUI();
            }

            openMissionSelect() {
              this.startScreen?.classList.add('hidden');
              this.hangarScreen?.classList.add('hidden');
              this.settingsModal?.classList.add('hidden');
              this.stageClearScreen?.classList.add('hidden');
              this.fase6ResultsScreen?.classList.add('hidden');
              this.missionSelectScreen?.classList.remove('hidden');

              this.selectedCampaignStage = Math.min(this.unlockedStage - 1, STAGES.length - 1);
              this.renderMissionSelect();
            }

            renderMissionSelect() {
              const list = document.getElementById('missionList');
              if (!list) return;
              list.innerHTML = '';

              STAGES.forEach((stage, index) => {
                const unlocked = (index + 1) <= this.unlockedStage;
                const isCompleted = (index + 1) < this.unlockedStage || (stage.isBonusStage && this.saveData.fase6Record && this.saveData.fase6Record.cleared);
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'mission-card' +
                  (stage.isBonusStage ? ' bonus' : '') +
                  (unlocked ? '' : ' locked') +
                  (isCompleted ? ' completed' : '') +
                  (index === this.selectedCampaignStage ? ' active' : '');
                button.disabled = !unlocked;

                let numBadge = '';
                if (stage.isBonusStage) {
                  numBadge = isCompleted
                    ? '<span class="mission-number">★ FASE 06 (BÔNUS) [CONCLUÍDA ✔]</span>'
                    : '<span class="mission-number">★ FASE 06 (BÔNUS HIPERSÔNICO)</span>';
                } else {
                  numBadge = isCompleted
                    ? `<span class="mission-number">FASE ${stage.stageNum.toString().padStart(2, '0')} [CONCLUÍDA ✔]</span>`
                    : `<span class="mission-number">FASE ${stage.stageNum.toString().padStart(2, '0')}</span>`;
                }

                let statusText = '';
                if (isCompleted) {
                  statusText = `✔ MISSÃO CONCLUÍDA — ${stage.subtitle}`;
                } else if (unlocked) {
                  statusText = stage.subtitle;
                } else {
                  statusText = stage.isBonusStage
                    ? '🔒 BLOQUEADA — CONCLUA A FASE 5 PARA LIBERAR'
                    : '🔒 BLOQUEADA — CONCLUA A FASE ANTERIOR';
                }

                button.innerHTML = `${numBadge}<strong>${stage.name}</strong><small>${statusText}</small>`;
                button.addEventListener('click', () => {
                  this.selectedCampaignStage = index;
                  this.renderMissionSelect();
                });
                list.appendChild(button);
              });

              const selected = STAGES[this.selectedCampaignStage] || STAGES[0];
              const briefing = document.getElementById('missionBriefing');
              if (briefing && selected) {
                let planeName = 'F-14 Tomcat';
                if (selected.playerPlane === 'darkstar') planeName = 'Darkstar Hipersônico';
                else if (selected.playerPlane === 'fa18') planeName = 'F/A-18 Super Hornet';

                let enemyDesc = 'Caças MiG-28 (F-5)';
                if (selected.stageNum === 2) enemyDesc = 'Caças A-4 Skyhawk';
                else if (selected.stageNum >= 3 && selected.stageNum <= 5) enemyDesc = 'Caças Su-57 Felon';
                else if (selected.stageNum === 6) enemyDesc = 'Nenhum (Chuva de Meteoritos, Satélites e Destroços Espaciais)';

                briefing.innerHTML = `<h3>${selected.name}</h3>
        <p>${selected.briefing}</p>
        <p><strong>Aeronave designada:</strong> ${planeName}</p>
        <p><strong>Ameaça da missão:</strong> ${enemyDesc}</p>
        <p><strong>Condições do voo:</strong> ${selected.hazard}</p>`;
              }

              const launch = document.getElementById('launchSelectedMissionBtn');
              if (launch) {
                launch.disabled = (this.selectedCampaignStage + 1) > this.unlockedStage;
              }
            }

            returnToMenu() {
              this.state = 'START';
              this.pauseScreen?.classList.add('hidden');
              this.gameOverScreen?.classList.add('hidden');
              this.shopScreen?.classList.add('hidden');
              this.leaderboardModal?.classList.add('hidden');
              this.missionSelectScreen?.classList.add('hidden');
              this.hangarScreen?.classList.add('hidden');
              this.settingsModal?.classList.add('hidden');
              this.stageClearScreen?.classList.add('hidden');
              this.fase6ResultsScreen?.classList.add('hidden');
              this.startScreen?.classList.remove('hidden');

              const menuGold = document.getElementById('menuGoldDisplay');
              if (menuGold) menuGold.innerText = this.totalGold.toLocaleString();
            }

            setDifficulty(diff) {
              this.selectedDifficulty = diff;
              this.saveData.difficulty = diff;
              StorageManager.save(this.saveData);
              this.updateDifficultyUI();
            }

            updateDifficultyUI() {
              document.querySelectorAll('.diff-btn[data-diff]').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.diff === this.selectedDifficulty);
              });
            }

            selectPlane(planeId) {
              if (!this.saveData.unlockedPlanes.includes(planeId)) return;
              this.selectedPlane = planeId;
              this.saveData.plane = planeId;
              this.player = new Player(this.width / 2, 750, this.selectedPlane, this.upgrades);
              StorageManager.save(this.saveData);
              this.updatePlaneSelectionUI();
            }

            updatePlaneSelectionUI() {
              const carousel = document.getElementById('garageCarousel');
              if (!carousel) return;
              carousel.innerHTML = '';

              const allPlanes = ['f14', 'fa18', 'mig28', 'a4', 'su57', 'darkstar'];

              allPlanes.forEach(planeId => {
                const data = PLANE_DATA[planeId];
                if (!data) return;

                const isUnlocked = this.saveData.unlockedPlanes.includes(planeId);
                const isSelected = this.selectedPlane === planeId;

                const card = document.createElement('div');
                card.className = 'plane-card' + (isSelected ? ' active' : '') + (isUnlocked ? '' : ' locked');
                card.dataset.plane = planeId;

                const flipClass = data.flipY ? ' flip-y' : '';
                const spriteSrc = data.spriteSrc || 'assets/player/f14_tomcat.png';

                card.innerHTML = `
        <div class="plane-pedestal">
          <img class="plane-sprite-image${flipClass}" src="${spriteSrc}" alt="${data.name}" width="96" height="96">
          <div class="pedestal-base"></div>
          <div class="pedestal-glow"></div>
        </div>
        <div class="plane-designation">${data.name.toUpperCase()}</div>
        <div class="plane-role-tag">${isUnlocked ? data.role.toUpperCase() : 'BLOQUEADO'}</div>
      `;

                if (isUnlocked) {
                  card.addEventListener('click', () => this.selectPlane(planeId));
                } else {
                  card.title = data.unlockRequirement || 'Bloqueado';
                }

                carousel.appendChild(card);
              });

              const activeData = PLANE_DATA[this.selectedPlane] || PLANE_DATA.f14;
              const title = document.getElementById('fighterDetailTitle');
              const special = document.getElementById('fighterDetailSpecial');
              const desc = document.getElementById('fighterDetailDesc');
              const speedFill = document.getElementById('statSpeedFill');
              const armorFill = document.getElementById('statArmorFill');
              const damageFill = document.getElementById('statDamageFill');

              if (title) title.innerText = activeData.name.toUpperCase();
              if (special) special.innerText = `Q: ${activeData.specialName.toUpperCase()}`;
              if (desc) desc.innerText = activeData.desc;
              if (speedFill) speedFill.style.width = `${activeData.statSpeed}%`;
              if (armorFill) armorFill.style.width = `${activeData.statArmor}%`;
              if (damageFill) damageFill.style.width = `${activeData.statDamage}%`;
            }

            startGame(stageIndex = 0) {
              sound.init();
              this.score = 0;
              this.stageScore = 0;
              this.stageKills = 0;
              this.stageGold = 0;
              this.sessionGold = 0;
              this.totalKills = 0;
              this.combo = 1;
              this.comboTimer = 0;
              this.lastSurvivalBiomeScore = 0;
              this.projectiles = [];
              this.enemyMgr.reset();

              const isCampaign = this.gameMode === 'campaign';

              if (isCampaign) {
                this.currentStageIndex = Math.max(0, Math.min(stageIndex, this.unlockedStage - 1, STAGES.length - 1));
                this.currentStageInfo = STAGES[this.currentStageIndex];
                const activePlane = this.currentStageInfo.playerPlane;
                this.player = new Player(this.width / 2, 750, activePlane, this.upgrades);
                this.background.setStage(this.currentStageInfo.id);

                if (this.currentStageInfo.stageNum === 6) {
                  this.fase6Manager.reset();
                }
              } else {
                this.currentStageIndex = 0;
                this.currentStageInfo = STAGES[0];
                this.player = new Player(this.width / 2, 750, this.selectedPlane, this.upgrades);
                this.background.setStage(this.currentStageInfo.id);
              }

              this.startScreen?.classList.add('hidden');
              this.hangarScreen?.classList.add('hidden');
              this.missionSelectScreen?.classList.add('hidden');
              this.settingsModal?.classList.add('hidden');
              this.pauseScreen?.classList.add('hidden');
              this.stageClearScreen?.classList.add('hidden');
              this.fase6ResultsScreen?.classList.add('hidden');
              this.gameOverScreen?.classList.add('hidden');
              this.shopScreen?.classList.add('hidden');
              this.leaderboardModal?.classList.add('hidden');

              this.state = 'PLAYING';
              this.lastTime = performance.now();
              this.ui.triggerRadio(this.currentStageInfo.briefing);
            }

            onBossDefeated() {
              if (this.gameMode === 'campaign') {
                this.onStageComplete();
              } else {
                this.addScore(5000);
                this.ui.triggerRadio('Ameaça neutralizada! Próximo setor no radar.');
              }
            }

            onStageComplete() {
              this.state = 'STAGE_CLEAR';
              const currentNum = this.currentStageInfo.stageNum;

              // Desbloqueia próxima fase (até 6)
              if (currentNum < 6) {
                this.unlockedStage = Math.max(this.unlockedStage, currentNum + 1);
                this.saveData.unlockedStage = this.unlockedStage;
              }

              // Recompensas progressivas e desbloqueios da campanha
              let unlockMsg = '';
              const unlockBox = document.getElementById('stageUnlockBox');
              const unlockText = document.getElementById('stageUnlockText');

              if (currentNum === 1) {
                if (!this.saveData.unlockedPlanes.includes('mig28')) {
                  this.saveData.unlockedPlanes.push('mig28');
                }
                unlockMsg = 'MiG-28 DESBLOQUEADO NO MODO INFINITO!';
              } else if (currentNum === 2) {
                if (!this.saveData.unlockedPlanes.includes('a4')) {
                  this.saveData.unlockedPlanes.push('a4');
                }
                unlockMsg = 'A-4 SKYHAWK DESBLOQUEADO NO MODO INFINITO!';
              } else if (currentNum === 3) {
                if (!this.saveData.unlockedPlanes.includes('su57')) {
                  this.saveData.unlockedPlanes.push('su57');
                }
                unlockMsg = 'Su-57 FELON DESBLOQUEADO NO MODO INFINITO!';
              } else if (currentNum === 4) {
                this.totalGold += 500;
                this.saveData.gold = this.totalGold;
                unlockMsg = 'MELHORIA DE HANGAR CONCEDIDA (+500 PEÇAS)!';
              } else if (currentNum === 5) {
                this.totalGold += 1500;
                this.saveData.gold = this.totalGold;
                unlockMsg = 'CAMPANHA PRINCIPAL CONCLUÍDA! FASE 6 BÔNUS LIBERADA!';
              }

              StorageManager.save(this.saveData);

              if (unlockBox && unlockText) {
                if (unlockMsg) {
                  unlockText.innerText = unlockMsg;
                  unlockBox.classList.remove('hidden');
                } else {
                  unlockBox.classList.add('hidden');
                }
              }

              const bonus = 250;
              this.sessionGold += bonus;
              this.totalGold += bonus;
              this.saveData.gold = this.totalGold;
              StorageManager.save(this.saveData);

              const sub = document.getElementById('stageClearSubtitle');
              if (sub) sub.innerText = `${this.currentStageInfo.name.toUpperCase()} CONCLUÍDO`;

              const killsElem = document.getElementById('stageKillsText');
              if (killsElem) killsElem.innerText = this.stageKills;

              const scoreElem = document.getElementById('stageScoreText');
              if (scoreElem) scoreElem.innerText = this.stageScore.toLocaleString();

              const goldElem = document.getElementById('stageGoldText');
              if (goldElem) goldElem.innerText = `🪙 ${this.stageGold}`;

              const bonusElem = document.getElementById('stageBonusText');
              if (bonusElem) bonusElem.innerText = `+${bonus} 🪙`;

              const nextBriefing = document.getElementById('nextStageBriefingText');
              if (nextBriefing) nextBriefing.innerText = this.currentStageInfo.nextBriefing;

              this.stageClearScreen?.classList.remove('hidden');
              sound.playPowerup();
            }

            onFase6Failed() {
              this.state = 'FASE6_RESULTS';

              // Desbloqueia o Darkstar no Modo Infinito ao voar na Fase 6
              if (!this.saveData.unlockedPlanes.includes('darkstar')) {
                this.saveData.unlockedPlanes.push('darkstar');
              }

              const dist = this.fase6Manager.distanceKm;
              const time = this.fase6Manager.survivalTime;
              const score = this.fase6Manager.score;

              const oldRecord = this.saveData.fase6Record || { distance: 0, time: 0, score: 0 };
              const isNewRecord = dist > (oldRecord.distance || 0);

              this.saveData.fase6Record = {
                distance: Math.max(oldRecord.distance || 0, dist),
                time: Math.max(oldRecord.time || 0, time),
                score: Math.max(oldRecord.score || 0, score),
                cleared: true
              };
              StorageManager.save(this.saveData);

              const distElem = document.getElementById('fase6DistanceText');
              if (distElem) distElem.innerText = `${dist.toFixed(1)} KM`;

              const m = Math.floor(time / 60);
              const s = Math.floor(time % 60);
              const timeElem = document.getElementById('fase6TimeText');
              if (timeElem) timeElem.innerText = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;

              const speedElem = document.getElementById('fase6SpeedText');
              if (speedElem) speedElem.innerText = `MACH ${this.fase6Manager.machSpeed.toFixed(1)}`;

              const scoreElem = document.getElementById('fase6ScoreText');
              if (scoreElem) scoreElem.innerText = score.toLocaleString();

              const recordElem = document.getElementById('fase6RecordText');
              if (recordElem) recordElem.innerText = `${this.saveData.fase6Record.distance.toFixed(1)} KM`;

              const newRecAlert = document.getElementById('fase6NewRecordAlert');
              if (newRecAlert) newRecAlert.classList.toggle('hidden', !isNewRecord);

              this.fase6ResultsScreen?.classList.remove('hidden');
              sound.playWarning();
            }

            togglePause() {
              if (this.state === 'PLAYING') {
                this.state = 'PAUSED';
                this.pauseScreen?.classList.remove('hidden');
                const pauseGold = document.getElementById('pauseGoldDisplay');
                if (pauseGold) pauseGold.innerText = this.sessionGold.toString();
              } else if (this.state === 'PAUSED') {
                this.state = 'PLAYING';
                this.pauseScreen?.classList.add('hidden');
                this.lastTime = performance.now();
              }
            }

            restartGame() {
              this.pauseScreen?.classList.add('hidden');
              this.gameOverScreen?.classList.add('hidden');
              this.startGame(this.currentStageIndex);
            }

            onGameOver() {
              this.state = 'GAME_OVER';
              sound.playWarning();

              const isSurvival = this.gameMode === 'survival';
              if (isSurvival && this.score > 0) {
                this.leaderboard = StorageManager.recordSurvivalScore(
                  this.score,
                  this.player.data.name,
                  this.totalKills
                );
                this.renderLeaderboard();
              }

              if (this.score > this.highScore) {
                this.highScore = this.score;
                this.saveData.highScore = this.highScore;
              }
              this.totalGold += this.sessionGold;
              this.saveData.gold = this.totalGold;
              StorageManager.save(this.saveData);

              const fScore = document.getElementById('finalScore');
              if (fScore) fScore.innerText = (isSurvival ? this.score : this.stageScore).toLocaleString();

              const hScore = document.getElementById('highScoreStat');
              if (hScore) hScore.innerText = this.highScore.toLocaleString();

              const killsStat = document.getElementById('killsStat');
              if (killsStat) killsStat.innerText = (isSurvival ? this.totalKills : this.stageKills).toString();

              const goldStat = document.getElementById('goldEarnedStat');
              if (goldStat) goldStat.innerText = `🪙 ${this.sessionGold}`;

              this.gameOverScreen?.classList.remove('hidden');
            }

            openShop() {
              this.previousState = this.state;
              this.state = 'SHOP';
              this.updateShopUI();
              this.shopScreen?.classList.remove('hidden');
            }

            closeShop() {
              this.shopScreen?.classList.add('hidden');
              this.state = this.previousState;
            }

            buyUpgrade(type) {
              const data = UPGRADE_DATA[type];
              if (!data) return;
              const currentLvl = this.upgrades[type] || 0;
              if (currentLvl >= data.maxLevel) return;
              const cost = Math.round(data.baseCost * Math.pow(data.mult, currentLvl));
              if (this.totalGold >= cost) {
                this.totalGold -= cost;
                this.upgrades[type] = currentLvl + 1;
                this.saveData.gold = this.totalGold;
                this.saveData.upgrades = this.upgrades;
                StorageManager.save(this.saveData);
                sound.playPowerup();
                this.updateShopUI();
              }
            }

            updateShopUI() {
              const shopGold = document.getElementById('shopGoldDisplay');
              if (shopGold) shopGold.innerText = this.totalGold.toString();

              const renderPips = (elemId, lvl, maxLvl) => {
                const el = document.getElementById(elemId);
                if (!el) return;
                el.innerHTML = '';
                for (let i = 0; i < maxLvl; i++) {
                  const pip = document.createElement('div');
                  pip.className = 'shop-pip' + (i < lvl ? ' active' : '');
                  el.appendChild(pip);
                }
              };

              ['armor', 'radiator', 'ammoDepot', 'thrusters', 'magnet'].forEach(type => {
                const data = UPGRADE_DATA[type];
                const lvl = this.upgrades[type] || 0;
                renderPips(`${type}LevelPips`, lvl, data.maxLevel);

                const btn = document.getElementById(`buy${type.charAt(0).toUpperCase() + type.slice(1)}Btn`);
                const costText = document.getElementById(`${type}CostText`);
                if (btn && costText) {
                  if (lvl >= data.maxLevel) {
                    costText.innerText = 'MAX';
                    btn.disabled = true;
                  } else {
                    const cost = Math.round(data.baseCost * Math.pow(data.mult, lvl));
                    costText.innerText = `${cost} PTS`;
                    btn.disabled = this.totalGold < cost;
                  }
                }
              });
            }

            openLeaderboard() {
              this.previousState = this.state;
              this.state = 'LEADERBOARD';
              this.renderLeaderboard();
              this.leaderboardModal?.classList.remove('hidden');
            }

            closeLeaderboard() {
              this.leaderboardModal?.classList.add('hidden');
              this.state = this.previousState;
            }

            renderLeaderboard() {
              const tbody = document.getElementById('leaderboardBody');
              if (!tbody) return;
              tbody.innerHTML = '';
              this.leaderboard.forEach(item => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
        <td class="rank-pos">#${item.rank}</td>
        <td class="rank-score">${item.score.toLocaleString()}</td>
        <td>${item.plane}</td>
        <td>${item.kills}</td>
        <td class="rank-date">${item.date}</td>
      `;
                tbody.appendChild(tr);
              });
            }

            addScore(pts) {
              this.score += pts * this.combo;
              this.stageScore += pts * this.combo;
            }

            checkCollisions() {
              const isFase6 = this.gameMode === 'campaign' && this.currentStageInfo && this.currentStageInfo.stageNum === 6;
              if (isFase6) return;

              const enemies = this.enemyMgr.enemies;
              const bullets = this.enemyMgr.enemyBullets;
              const boss = this.enemyMgr.boss;

              // Balas do jogador vs Inimigos
              for (let p of this.projectiles) {
                if (!p.alive) continue;

                for (let e of enemies) {
                  if (!e.alive || e.hp <= 0) continue;
                  const d = Math.hypot(p.x - e.x, p.y - e.y);
                  if (d < p.radius + e.radius) {
                    e.takeDamage(p.damage, this.particles);
                    p.alive = false;

                    if (!e.alive || e.hp <= 0) {
                      e.alive = false;
                      const sVal = e.scoreValue || e.scoreVal || 100;
                      this.addScore(sVal);
                      this.stageKills++;
                      this.totalKills++;
                      this.combo++;
                      this.comboTimer = this.comboMaxTimer;
                      this.enemyMgr.dropCoins(e.x, e.y, Math.floor(Math.random() * 2) + 1);
                      if (Math.random() < 0.14) this.enemyMgr.dropPowerUp(e.x, e.y);
                    }
                    break;
                  }
                }

                // Balas do jogador vs Chefe
                if (p.alive && boss && boss.alive && boss.hp > 0) {
                  const d = Math.hypot(p.x - boss.x, p.y - boss.y);
                  if (d < p.radius + boss.radius) {
                    boss.takeDamage(p.damage, this.particles);
                    p.alive = false;
                    this.addScore(25);
                  }
                }
              }

              // Balas inimigas vs Jogador
              for (let b of bullets) {
                if (!b.alive) continue;
                const d = Math.hypot(b.x - this.player.x, b.y - this.player.y);
                if (d < b.radius + this.player.radius) {
                  b.alive = false;
                  this.player.takeDamage(b.damage, this.particles, 1.0, this.ui);
                  this.combo = 1;
                  if (this.player.hp <= 0) {
                    this.onGameOver();
                    return;
                  }
                }
              }

              // Inimigos colidindo com Jogador (Dano de impacto)
              for (let e of enemies) {
                if (!e.alive) continue;
                const d = Math.hypot(e.x - this.player.x, e.y - this.player.y);
                if (d < e.radius + this.player.radius) {
                  e.takeDamage(80, this.particles);
                  this.player.takeDamage(25, this.particles, 1.0, this.ui);
                  this.combo = 1;
                  if (this.player.hp <= 0) {
                    this.onGameOver();
                    return;
                  }
                }
              }

              // Coleta de Moedas e Itens
              for (let c of this.enemyMgr.coins) {
                if (c.collected) continue;
                const d = Math.hypot(c.x - this.player.x, c.y - this.player.y);
                if (d < this.player.magnetRadius) {
                  c.x += (this.player.x - c.x) * 0.18;
                  c.y += (this.player.y - c.y) * 0.18;
                }
                if (d < 24) {
                  c.collected = true;
                  this.stageGold++;
                  this.sessionGold++;
                  sound.playCoin();
                }
              }

              for (let pw of this.enemyMgr.powerups) {
                if (pw.collected) continue;
                const d = Math.hypot(pw.x - this.player.x, pw.y - this.player.y);
                if (d < 26) {
                  pw.collected = true;
                  sound.playPowerup();
                  if (pw.type === 'W') this.player.weaponLevel = Math.min(3, this.player.weaponLevel + 1);
                  else if (pw.type === 'M') this.player.missiles = Math.min(this.player.maxMissiles, this.player.missiles + 4);
                  else if (pw.type === 'B') this.player.bombs = Math.min(this.player.maxBombs, this.player.bombs + 1);
                  else if (pw.type === 'S') this.player.hp = Math.min(this.player.maxHp, this.player.hp + 35);
                }
              }
            }

            update(dt) {
              if (this.state !== 'PLAYING') return;

              const isFase6 = this.gameMode === 'campaign' && this.currentStageInfo && this.currentStageInfo.stageNum === 6;

              if (isFase6) {
                this.input.update();
                this.player.update(dt, this.input, this.particles, [], [], [], null, 1.0, this.ui);
                this.background.update(dt, [], this.player.x, this.player.y, 1.0);
                this.particles.update(dt);
                this.fase6Manager.update(dt, this.player, this.particles, this.background);

                this.touchRollBtn?.classList.toggle('cooldown', this.player.rollCooldown > 0);
                this.touchSpecialBtn?.classList.toggle('ready', this.player.specialCooldown <= 0);
                this.touchSpecialBtn?.classList.toggle('cooldown', this.player.specialCooldown > 0);
                this.touchBombBtn?.classList.toggle('cooldown', true);
                this.touchMissileBtn?.classList.toggle('cooldown', true);
                return;
              }

              const timeScale = this.player.focusActive ? 0.4 : 1.0;
              const gameDt = dt * timeScale;

              this.input.update();

              if (this.comboTimer > 0) {
                this.comboTimer -= dt;
                if (this.comboTimer <= 0) this.combo = 1;
              }

              const diffMods = { ...(this.gameMode === 'campaign' ? DIFFICULTY_MODS.medium : DIFFICULTY_MODS[this.selectedDifficulty]) };
              if (this.gameMode === 'campaign') {
                const phaseScale = this.currentStageIndex;
                diffMods.hpMult += phaseScale * 0.22;
                diffMods.shootFreqMult += phaseScale * 0.12;
                diffMods.bulletSpeedMult += phaseScale * 0.10;
              }

              const isSurvival = this.gameMode === 'survival';
              if (isSurvival) {
                const survivalScale = this.score / 2000;
                diffMods.hpMult += survivalScale * 0.4;
                diffMods.shootFreqMult += survivalScale * 0.25;
                diffMods.bulletSpeedMult += survivalScale * 0.2;

                const currentSurvivalInterval = Math.floor(this.score / 2500);
                if (currentSurvivalInterval > this.lastSurvivalBiomeScore) {
                  this.lastSurvivalBiomeScore = currentSurvivalInterval;
                  const stageIdx = currentSurvivalInterval % 5;
                  this.currentStageInfo = STAGES[stageIdx];
                  this.background.transitionToStage(this.currentStageInfo.id, 3.0);
                  this.weather.setStage(this.currentStageInfo.id, true);
                  this.ui.triggerRadio(`Transição de setor: ${this.currentStageInfo.name.toUpperCase()}!`);
                }
              }

              this.background.update(gameDt, this.enemyMgr.enemyBullets, this.player.x, this.player.y, diffMods.bulletSpeedMult);
              this.weather.update(gameDt, this.player, this.particles, this.enemyMgr.enemyBullets);
              this.particles.update(gameDt);

              this.player.update(
                dt,
                this.input,
                this.particles,
                this.projectiles,
                this.enemyMgr.enemies,
                this.enemyMgr.enemyBullets,
                this.enemyMgr.boss,
                diffMods.playerDamageMult,
                this.ui
              );

              for (let i = this.projectiles.length - 1; i >= 0; i--) {
                const p = this.projectiles[i];
                const keep = p.update(dt, this.enemyMgr.enemies);
                if (p.isMissile) this.particles.addSmoke(p.x, p.y + 10);
                if (!keep || !p.alive) this.projectiles.splice(i, 1);
              }

              this.enemyMgr.update(
                gameDt,
                this.player,
                this.particles,
                isSurvival ? this.score : this.stageScore,
                diffMods,
                this.ui,
                this.currentStageInfo,
                () => this.onBossDefeated(),
                isSurvival
              );

              this.checkCollisions();

              this.touchRollBtn?.classList.toggle('cooldown', this.player.rollCooldown > 0);
              this.touchSpecialBtn?.classList.toggle('ready', this.player.specialCooldown <= 0);
              this.touchSpecialBtn?.classList.toggle('cooldown', this.player.specialCooldown > 0);
              this.touchBombBtn?.classList.toggle('cooldown', this.player.bombs <= 0);
              if (this.touchBombLabel) this.touchBombLabel.innerText = `[${this.player.bombs}]`;
              if (this.touchMissileLabel) this.touchMissileLabel.innerText = `[${this.player.missiles}]`;
              this.touchMissileBtn?.classList.toggle('cooldown', this.player.missiles <= 0);
              this.touchFocusBtn?.classList.toggle('cooldown', this.player.focus < 25 || this.player.focusActive);
            }

            drawHUD() {
              const ctx = this.ctx;
              ctx.save();

              // Barra de Vida do Jogador
              const hpY = 48;
              ctx.fillStyle = 'rgba(5, 12, 10, 0.85)';
              ctx.strokeStyle = '#00ff41';
              ctx.lineWidth = 1;
              ctx.fillRect(14, hpY, 140, 10);
              ctx.strokeRect(14, hpY, 140, 10);

              const hpPct = Math.max(0, this.player.hp / this.player.maxHp);
              ctx.fillStyle = hpPct > 0.5 ? '#00ff41' : (hpPct > 0.25 ? '#ff9100' : '#ff1744');
              ctx.fillRect(15, hpY + 1, 138 * hpPct, 8);

              ctx.fillStyle = '#00ff41';
              ctx.font = '900 9px "Courier New", monospace';
              ctx.fillText(`HP ${Math.round(this.player.hp)}/${this.player.maxHp}`, 16, hpY + 22);

              // Barra de Calor da Arma (Overheat)
              const heatY = 76;
              ctx.fillStyle = 'rgba(5, 12, 10, 0.85)';
              ctx.strokeStyle = '#ff9100';
              ctx.fillRect(14, heatY, 140, 6);
              ctx.strokeRect(14, heatY, 140, 6);

              const heatPct = Math.min(1, this.player.heat / 100);
              ctx.fillStyle = this.player.overheated ? '#ff1744' : '#ff9100';
              ctx.fillRect(15, heatY + 1, 138 * heatPct, 4);

              ctx.fillStyle = this.player.overheated ? '#ff1744' : '#ff9100';
              ctx.font = '900 8px "Courier New", monospace';
              ctx.fillText(this.player.overheated ? 'ARMA TRAVADA [RESFRIANDO]' : `CALOR ${Math.round(this.player.heat)}%`, 16, heatY + 16);

              // Painel Central Superior: Pontos e Fase
              ctx.textAlign = 'right';
              const isCampaign = this.gameMode === 'campaign';
              const rawStageName = (this.currentStageInfo && this.currentStageInfo.name) ? this.currentStageInfo.name.toUpperCase() : 'SETOR';
              const phaseText = isCampaign ? `CAMPANHA: ${rawStageName}` : `INFINITO: ${rawStageName}`;

              ctx.fillStyle = '#00e5ff';
              ctx.font = '900 11px "Courier New", monospace';
              ctx.fillText(phaseText, this.width - 16, hpY + 8);

              const scoreVal = isCampaign ? this.stageScore : this.score;
              ctx.fillStyle = '#ffd54f';
              ctx.font = '900 14px "Courier New", monospace';
              ctx.fillText(`${scoreVal.toLocaleString()} PTS`, this.width - 16, hpY + 24);

              // Moedas / Ouro
              ctx.fillStyle = '#ffd54f';
              ctx.font = '900 10px "Courier New", monospace';
              ctx.fillText(`🪙 ${this.sessionGold}`, this.width - 16, hpY + 38);

              ctx.restore();
            }

            render() {
              const ctx = this.ctx;
              ctx.clearRect(0, 0, this.width, this.height);

              ctx.save();
              this.particles.applyScreenShake(ctx);

              if (this.player && this.player.focusActive) {
                ctx.fillStyle = 'rgba(0, 176, 255, 0.12)';
                ctx.fillRect(0, 0, this.width, this.height);
              }

              this.background.draw(ctx);

              const isFase6 = this.gameMode === 'campaign' && this.currentStageInfo && this.currentStageInfo.stageNum === 6;

              if (isFase6) {
                if (this.fase6Manager) this.fase6Manager.draw(ctx);
                if (this.player && this.player.hp > 0) this.player.draw(ctx);
                this.particles.draw(ctx);
              } else {
                this.weather.draw(ctx);
                this.enemyMgr.draw(ctx);

                for (let p of this.projectiles) p.draw(ctx);
                if (this.player && this.player.hp > 0) this.player.draw(ctx);
                this.particles.draw(ctx);
                this.background.drawForegroundClouds(ctx);
              }

              if (this.player && this.player.hp > 0 && (this.player.hp / this.player.maxHp) < 0.3) {
                const pulseAlpha = 0.22 + 0.14 * Math.sin(Date.now() / 140);
                const radGrad = ctx.createRadialGradient(this.width / 2, this.height / 2, 120, this.width / 2, this.height / 2, 460);
                radGrad.addColorStop(0, 'rgba(255, 23, 68, 0)');
                radGrad.addColorStop(1, `rgba(255, 23, 68, ${pulseAlpha})`);
                ctx.fillStyle = radGrad;
                ctx.fillRect(0, 0, this.width, this.height);
              }

              ctx.restore();

              if (this.state === 'PLAYING' || this.state === 'PAUSED') {
                if (isFase6 && this.fase6Manager) {
                  this.fase6Manager.drawHUD(ctx);
                } else {
                  this.drawHUD();
                }
              }
            }

            loop(timestamp) {
              const elapsed = (timestamp - this.lastTime) / 1000;
              const dt = Number.isFinite(elapsed) ? Math.max(0, Math.min(elapsed, 0.033)) : 0;
              this.lastTime = timestamp;

              try {
                this.update(dt);
                this.render();
              } catch (error) {
                console.error('Erro durante o ciclo do jogo:', error);
                this.state = this.state === 'START' ? 'START' : 'PAUSED';
                if (this.state === 'START' && this.startScreen) this.startScreen.classList.remove('hidden');
              } finally {
                requestAnimationFrame((t) => this.loop(t));
              }
            }
          }

          // Escala uniforme para PC, tablet e celular
          function fitGameToViewport() {
            const container = document.getElementById('game-container');
            if (!container) return;
            const logicalWidth = 540;
            const logicalHeight = 960;
            const viewportWidth = Math.max(1, window.innerWidth || document.documentElement.clientWidth);
            const viewportHeight = Math.max(1, window.innerHeight || document.documentElement.clientHeight);
            const availableWidth = Math.max(1, viewportWidth - 16);
            const availableHeight = Math.max(1, viewportHeight - 16);
            const scale = Math.min(availableWidth / logicalWidth, availableHeight / logicalHeight);
            container.style.setProperty('--game-scale', String(scale));
            container.style.setProperty('--game-scaled-width', `${logicalWidth * scale}px`);
            container.style.setProperty('--game-scaled-height', `${logicalHeight * scale}px`);
          }

          window.addEventListener('resize', fitGameToViewport, { passive: true });
          window.addEventListener('orientationchange', fitGameToViewport, { passive: true });
          if (window.visualViewport) {
            window.visualViewport.addEventListener('resize', fitGameToViewport, { passive: true });
          }

          // Inicialização ao carregar a página
          window.addEventListener('DOMContentLoaded', () => {
            fitGameToViewport();
            const startScreen = document.getElementById('startScreen');
            if (startScreen) startScreen.classList.remove('hidden');

            const overlaysToHide = [
              'hangarScreen', 'settingsModal', 'pauseScreen', 'stageClearScreen',
              'fase6ResultsScreen', 'victoryScreen', 'gameOverScreen', 'shopScreen',
              'leaderboardModal', 'missionSelectScreen'
            ];
            overlaysToHide.forEach(id => {
              const el = document.getElementById(id);
              if (el) el.classList.add('hidden');
            });

            window.game = new GameEngine();
          });
