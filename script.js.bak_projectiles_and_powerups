                { cat: 'satelites', sx: 15, sy: 26, sw: 70, sh: 49, radius: 24, damage: 20, name: 'Microssatélite' },
                { cat: 'satelites', sx: 114, sy: 23, sw: 75, sh: 56, radius: 26, damage: 22, name: 'Satélite Cubesat' },
                { cat: 'satelites', sx: 1, sy: 104, sw: 94, sh: 84, radius: 30, damage: 25, name: 'Sonda Orbital' },
                { cat: 'satelites', sx: 113, sy: 115, sw: 66, sh: 64, radius: 25, damage: 22, name: 'Satélite de Comunicações' },
                { cat: 'satelites', sx: 9, sy: 211, sw: 77, sh: 74, radius: 28, damage: 24, name: 'Satélite Meteorológico' },

                // 3 Destroços Espaciais (assets/fase6/satelites.png)
                { cat: 'satelites', sx: 106, sy: 212, sw: 81, sh: 76, radius: 28, damage: 22, name: 'Satélite Avariado' },
                { cat: 'satelites', sx: 8, sy: 307, sw: 79, sh: 77, radius: 25, damage: 20, name: 'Estágio de Foguete' },
                { cat: 'satelites', sx: 112, sy: 318, sw: 68, sh: 64, radius: 26, damage: 24, name: 'Módulo Desativado' }
              ];
            }

            initSpeedLines() {
              this.speedLines = [];
              for (let i = 0; i < 28; i++) {
                this.speedLines.push({
                  x: Math.random() * this.width,
                  y: Math.random() * this.height,
                  length: Math.random() * 45 + 30,
                  speed: Math.random() * 400 + 700,
                  alpha: Math.random() * 0.45 + 0.15
                });
              }
            }

            reset() {
              this.obstacles = [];
              this.spawnTimer = 0.8;
              this.survivalTime = 0;
              this.distanceKm = 0;
              this.score = 0;
              this.machSpeed = 6.0;
              this.resistance = 100;
              this.isGameOver = false;
              this.lastMilestoneSec = 0;
              this.milestoneBanner = null;
              this.initSpeedLines();
            }

            spawnObstacle() {
              const def = this.obstacleDefs[Math.floor(Math.random() * this.obstacleDefs.length)];
              const minX = def.radius + 20;
              const maxX = this.width - def.radius - 20;
              let x = Math.random() * (maxX - minX) + minX;

              for (const ob of this.obstacles) {
                if (ob.y < 80 && Math.abs(ob.x - x) < (ob.radius + def.radius + 35)) {
                  x = (x + 140) % (maxX - minX) + minX;
                }
              }

              const speedScale = 1 + (this.machSpeed - 6) * 0.15;
              const vy = (Math.random() * 80 + 340) * speedScale;
              const vx = (Math.random() - 0.5) * 45;
              const rotSpeed = (Math.random() - 0.5) * 1.8;

              this.obstacles.push({
                ...def,
                x: x,
                y: -def.radius - 20,
                vx: vx,
                vy: vy,
                angle: Math.random() * Math.PI * 2,
                rotSpeed: rotSpeed,
                alive: true
              });
            }

            update(dt, player, particles, background) {
              if (this.isGameOver) return;

              this.survivalTime += dt;
              this.machSpeed = 6.0 + Math.min(6.5, (this.survivalTime / 18) * 0.85);
              this.distanceKm += (this.machSpeed * 1.25) * dt;
              this.score += Math.round(this.machSpeed * 12 * dt);

              if (background) {
                background.scrollSpeed = 2.2 + (this.machSpeed - 6) * 0.45;
              }

              // Marcos de sobrevivência a cada 30 segundos
              const currentMilestone = Math.floor(this.survivalTime / 30);
              if (currentMilestone > this.lastMilestoneSec && currentMilestone > 0) {
                this.lastMilestoneSec = currentMilestone;
                this.milestoneBanner = {
                  text: `⚡ VELOCIDADE CRÍTICA // MACH ${this.machSpeed.toFixed(1)}`,
                  timer: 2.8,
                  maxTimer: 2.8
                };
                sound.playWarning();
              }

              if (this.milestoneBanner) {
                this.milestoneBanner.timer -= dt;
                if (this.milestoneBanner.timer <= 0) {
                  this.milestoneBanner = null;
                }
              }

              for (const sl of this.speedLines) {
                sl.y += (sl.speed * (this.machSpeed / 6)) * dt;
                if (sl.y > this.height) {
                  sl.y = -sl.length;
                  sl.x = Math.random() * this.width;
                }
              }

              this.spawnTimer -= dt;
              const targetInterval = Math.max(0.48, 1.1 - (this.survivalTime / 60) * 0.35);
              if (this.spawnTimer <= 0) {
                this.spawnObstacle();
                this.spawnTimer = targetInterval;
              }

              for (let i = this.obstacles.length - 1; i >= 0; i--) {
                const ob = this.obstacles[i];
                ob.x += ob.vx * dt;
                ob.y += ob.vy * dt;
                ob.angle += ob.rotSpeed * dt;

                const dx = player.x - ob.x;
                const dy = player.y - ob.y;
                const dist = Math.hypot(dx, dy);

                if (dist < ob.radius + player.radius) {
                  if (player.invulnerableTimer <= 0 && player.barrelRollTimer <= 0) {
                    const dmg = ob.damage;
                    this.resistance = Math.max(0, this.resistance - dmg);
                    player.invulnerableTimer = 1.2;
                    player.hp = Math.round((this.resistance / 100) * player.maxHp);

                    particles.addExplosion(ob.x, ob.y, 16, true);
                    this.engine.particles.addScreenShake(8, 0.25);
                    sound.playExplosion();

                    ob.alive = false;

                    if (this.resistance <= 0) {
                      this.isGameOver = true;
                      this.engine.onFase6Failed();
                      return;
                    }
                  }
                }

                if (ob.y > this.height + ob.radius + 50 || ob.x < -ob.radius - 50 || ob.x > this.width + ob.radius + 50) {
                  ob.alive = false;
                }

                if (!ob.alive) {
                  this.obstacles.splice(i, 1);
                }
              }
            }

            draw(ctx) {
              ctx.save();
              ctx.strokeStyle = '#00e5ff';
              ctx.lineWidth = 1.2;
              for (const sl of this.speedLines) {
                ctx.globalAlpha = sl.alpha;
                ctx.beginPath();
                ctx.moveTo(sl.x, sl.y);
                ctx.lineTo(sl.x, sl.y + sl.length);
                ctx.stroke();
              }
              ctx.restore();

              for (const ob of this.obstacles) {
                const img = ob.cat === 'meteorito' ? fase6Sprites.meteorito : fase6Sprites.satelites;
                if (img && img.complete && img.naturalWidth > 0) {
                  ctx.save();
                  ctx.translate(ob.x, ob.y);
                  ctx.rotate(ob.angle);
                  ctx.drawImage(
                    img,
                    ob.sx, ob.sy, ob.sw, ob.sh,
                    -ob.radius, -ob.radius, ob.radius * 2, ob.radius * 2
                  );
                  ctx.restore();
                } else {
                  ctx.save();
                  ctx.translate(ob.x, ob.y);
                  ctx.fillStyle = ob.cat === 'meteorito' ? '#8d5b28' : '#00b0ff';
                  ctx.beginPath();
                  ctx.arc(0, 0, ob.radius, 0, Math.PI * 2);
                  ctx.fill();
                  ctx.restore();
                }
              }

              if (this.milestoneBanner) {
                const alpha = Math.min(1, this.milestoneBanner.timer / 0.5, (this.milestoneBanner.maxTimer - this.milestoneBanner.timer) / 0.5);
                ctx.save();
                ctx.globalAlpha = Math.max(0, Math.min(1, alpha));
                ctx.fillStyle = 'rgba(5, 25, 38, 0.85)';
                ctx.strokeStyle = '#ff9100';
                ctx.lineWidth = 1.5;
                const bw = 340;
                const bh = 38;
                const bx = (this.width - bw) / 2;
                const by = 130;
                ctx.fillRect(bx, by, bw, bh);
                ctx.strokeRect(bx, by, bw, bh);

                ctx.fillStyle = '#ff9100';
                ctx.font = '900 13px "Courier New", monospace';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.shadowColor = '#ff9100';
                ctx.shadowBlur = 10;
                ctx.fillText(this.milestoneBanner.text, this.width / 2, by + bh / 2);
                ctx.restore();
              }
            }

            drawHUD(ctx) {
              ctx.save();
              const hudY = 48;
              ctx.fillStyle = 'rgba(4, 18, 28, 0.82)';
              ctx.strokeStyle = 'rgba(35, 217, 238, 0.5)';
              ctx.lineWidth = 1;
              ctx.fillRect(14, hudY, this.width - 28, 44);
              ctx.strokeRect(14, hudY, this.width - 28, 44);

              ctx.fillStyle = '#ff9100';
              ctx.font = '900 12px "Courier New", monospace';
              ctx.textAlign = 'left';
              ctx.fillText(`MACH ${this.machSpeed.toFixed(1)}`, 24, hudY + 18);
              ctx.fillStyle = '#7fa6b1';
              ctx.font = '9px "Courier New", monospace';
              ctx.fillText('VELOCIDADE', 24, hudY + 34);

              ctx.fillStyle = '#00e5ff';
              ctx.font = '900 12px "Courier New", monospace';
              ctx.textAlign = 'center';
              ctx.fillText(`${this.distanceKm.toFixed(1)} KM`, this.width / 2, hudY + 18);
              ctx.fillStyle = '#7fa6b1';
              ctx.font = '9px "Courier New", monospace';
              ctx.fillText('DISTÂNCIA', this.width / 2, hudY + 34);

              const m = Math.floor(this.survivalTime / 60);
              const s = Math.floor(this.survivalTime % 60);
              const timeStr = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
              ctx.fillStyle = '#ffd54f';
              ctx.font = '900 12px "Courier New", monospace';
              ctx.textAlign = 'right';
              ctx.fillText(timeStr, this.width - 24, hudY + 18);
              ctx.fillStyle = '#7fa6b1';
              ctx.font = '9px "Courier New", monospace';
              ctx.fillText('TEMPO VOO', this.width - 24, hudY + 34);

              const barW = this.width - 40;
              const barH = 10;
              const barX = 20;
              const barY = this.height - 35;

              ctx.fillStyle = 'rgba(5, 20, 30, 0.85)';
              ctx.strokeStyle = 'rgba(0, 229, 255, 0.4)';
              ctx.fillRect(barX, barY, barW, barH);
              ctx.strokeRect(barX, barY, barW, barH);

              const fillW = Math.max(0, (this.resistance / this.maxResistance) * (barW - 4));
              let barColor = '#00e676';
              if (this.resistance < 35) barColor = '#ff1744';
              else if (this.resistance < 65) barColor = '#ff9100';

              ctx.fillStyle = barColor;
              ctx.fillRect(barX + 2, barY + 2, fillW, barH - 4);

              ctx.fillStyle = '#e0faea';
              ctx.font = '900 9px "Courier New", monospace';
              ctx.textAlign = 'left';
              ctx.fillText(`RESISTÊNCIA DO DARKSTAR: ${Math.round(this.resistance)}%`, barX, barY - 5);

              ctx.restore();
            }
          }

          // --- 15. CONTROLADOR DE INTERFACE E RÁDIO TÁTICO (UIController) ---
          class UIController {
            constructor(engine) {
              this.engine = engine;
              this.radioBox = document.getElementById('militaryRadioBox');
              this.radioText = document.getElementById('radioMessageText');
              this.radioTimer = null;
            }

            triggerRadio(msg) {
              if (!this.radioBox || !this.radioText || !msg) return;
              this.radioText.innerText = msg;
              this.radioBox.classList.remove('hidden');
              if (this.radioTimer) clearTimeout(this.radioTimer);
              this.radioTimer = setTimeout(() => {
                if (this.radioBox) this.radioBox.classList.add('hidden');
                this.radioTimer = null;
              }, 4500);
            }
          }

          // --- 16. MOTOR PRINCIPAL DO JOGO (GameEngine) ---
