              // 4. Modal de Configurações
              const btnCloseSettings = document.getElementById('closeSettingsBtn');
              if (btnCloseSettings) {
                btnCloseSettings.addEventListener('click', () => this.closeSettings());
              }

              const btnSettingsMusic = document.getElementById('settingsMusicBtn');
              if (btnSettingsMusic) {
                btnSettingsMusic.addEventListener('click', (e) => {
                  sound.init();
                  const on = sound.toggleMusic();
                  e.target.innerText = on ? 'LIGADA' : 'DESLIGADA';
                  e.target.classList.toggle('active', on);
                });
              }

              const btnSettingsSfx = document.getElementById('settingsSfxBtn');
              if (btnSettingsSfx) {
                btnSettingsSfx.addEventListener('click', (e) => {
                  sound.init();
                  const on = sound.toggleSfx();
                  e.target.innerText = on ? 'LIGADOS' : 'DESLIGADOS';
                  e.target.classList.toggle('active', on);
                });
              }

              const btnSettingsAudioMaster = document.getElementById('settingsAudioMasterBtn');
              if (btnSettingsAudioMaster) {
                btnSettingsAudioMaster.addEventListener('click', (e) => {
                  sound.init();
                  const isMuted = sound.toggleMute();
                  e.target.innerText = isMuted ? 'MUDO' : 'ATIVO';
                  e.target.classList.toggle('active', !isMuted);
                  if (this.soundBtn) this.soundBtn.innerText = isMuted ? '[ AUDIO: OFF ]' : '[ AUDIO: ON ]';
                });
              }

              // 5. Conclusão da Fase da Campanha (Fases 1 a 5) — ÚNICA OPÇÃO DE NAVEGAÇÃO
              const btnStageClearBack = document.getElementById('stageClearBackToStoryBtn');
              if (btnStageClearBack) {
                btnStageClearBack.addEventListener('click', () => {
                  this.stageClearScreen.classList.add('hidden');
                  this.openMissionSelect();
                });
              }

              // 6. Conclusão / Fim da Fase 6 Bônus — ÚNICA OPÇÃO DE NAVEGAÇÃO
              const btnFase6Back = document.getElementById('fase6BackToStoryBtn');
              if (btnFase6Back) {
                btnFase6Back.addEventListener('click', () => {
                  this.fase6ResultsScreen.classList.add('hidden');
                  this.openMissionSelect();
                });
